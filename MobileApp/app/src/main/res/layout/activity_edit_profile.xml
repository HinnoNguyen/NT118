<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".EditProfileActivity">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="◀"
            android:textColor="@color/accent_green"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="EDIT PROFILE"
            android:textColor="@color/accent_green"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/accent_green"
                android:textSize="12sp" />

            <include layout="@layout/layout_notification_bell" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent_green"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- User Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_main_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCurrentAvatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_button_unselected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_text_border"
                            android:fontFamily="monospace"
                            android:hint="Username"
                            android:textColor="@color/accent_yellow"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:padding="4dp"
                            android:inputType="textPersonName" />

                        <EditText
                            android:id="@+id/etUserTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_text_border"
                            android:fontFamily="monospace"
                            android:hint="Title"
                            android:textColor="#8A2BE2"
                            android:textSize="12sp"
                            android:padding="4dp"
                            android:inputType="text" />

                        <TextView
                            android:id="@+id/tvLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:text="LV.1"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">
                            <ProgressBar
                                android:id="@+id/expProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:progress="0"
                                android:progressDrawable="@android:drawable/progress_horizontal"
                                android:progressTint="@color/accent_yellow" />
                            <TextView
                                android:id="@+id/tvExpValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="-14dp"
                                android:fontFamily="monospace"
                                android:text="0/100"
                                android:textColor="#AAAAAA"
                                android:textSize="10sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Avatar Selection Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_main_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/choose_avatar_label"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="4"
                    android:alignmentMode="alignBounds">

                    <ImageView
                        android:id="@+id/avatar1"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_button_selected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_1"
                        android:clickable="true"
                        android:focusable="true" />
                    <ImageView
                        android:id="@+id/avatar2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_2"
                        android:clickable="true"
                        android:focusable="true" />
                    <ImageView
                        android:id="@+id/avatar3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_3"
                        android:clickable="true"
                        android:focusable="true" />
                    <ImageView
                        android:id="@+id/avatar4"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_4"
                        android:clickable="true"
                        android:focusable="true" />
                    <ImageView
                        android:id="@+id/avatar5"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_5"
                        android:clickable="true"
                        android:focusable="true" />
                    <ImageView
                        android:id="@+id/avatar6"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:padding="8dp"
                        android:src="@drawable/ic_avatar_6"
                        android:clickable="true"
                        android:focusable="true" />
                </GridLayout>
            </LinearLayout>

            <!-- Bio Edit Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_main_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/profile_bio_label"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_text_border"
                    android:fontFamily="monospace"
                    android:text="Adventurer of productivity realms"
                    android:textColor="@color/accent_green"
                    android:textSize="14sp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="monospace"
                android:text="@string/btn_save_profile"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:cornerRadius="4dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        layout="@layout/layout_bottom_nav"
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
