<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".NotesActivity">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SCROLL KEEPER - NOTE"
            android:textColor="@color/accent_yellow"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/accent_green"
                android:textSize="12sp" />

            <include layout="@layout/layout_notification_bell" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent_green"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tool Bar Row (Filters + New Button) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Filters -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_filter_button"
                        android:backgroundTint="@color/accent_yellow"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="16dp"
                        android:text="ALL"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnFilterNotes"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_filter_button"
                        android:gravity="center"
                        android:text="📝"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnFilterReminders"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_filter_button"
                        android:gravity="center"
                        android:text="🔔"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnFilterFlashcards"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_filter_button"
                        android:gravity="center"
                        android:text="🃏"
                        android:textSize="16sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- New Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewNote"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent_green"
                    android:fontFamily="monospace"
                    android:minHeight="0dp"
                    android:minWidth="40dp"
                    android:paddingHorizontal="12dp"
                    android:text="+ NEW"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="0dp"
                    android:insetBottom="0dp"
                    android:insetTop="0dp" />
            </LinearLayout>

            <!-- New Note Section -->
            <LinearLayout
                android:id="@+id/newNoteSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_main_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Type Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTypeNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/note_purple"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="📄 NOTE"
                        android:textColor="@color/white"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnTypeReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="🔔 REMINDER"
                        android:textColor="#AAAAAA"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnTypeFlashcard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="🃏 FLASHCARD"
                        android:textColor="#AAAAAA"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Reminder Time Layout -->
                <LinearLayout
                    android:id="@+id/reminderTimeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="TIME:"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReminderTime"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_unselected"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:text="12:00"
                        android:textColor="@color/white"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Input Fields -->
                <EditText
                    android:id="@+id/etNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_unselected"
                    android:fontFamily="monospace"
                    android:hint="Title..."
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#44FFFFFF"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/etNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_unselected"
                    android:fontFamily="monospace"
                    android:hint="Content..."
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#44FFFFFF"
                    android:textSize="14sp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no" />

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveScroll"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/accent_green"
                    android:text="✦ SAVE SCROLL"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="0dp" />
            </LinearLayout>

            <!-- Notes List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_note" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        layout="@layout/layout_bottom_nav"
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>